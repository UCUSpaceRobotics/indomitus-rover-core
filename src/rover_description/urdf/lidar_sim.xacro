<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    RPLIDAR S2 fragment as a macro. Call `lidar_sim simulate_scan="true|false"` to
    include the simulated sensor (topic publishing). The visual/collision
    geometry and joint are always added so the model is visible in the GUI.
  -->

  <xacro:macro name="lidar_sim" params="simulate_scan:false">

    <material name="lidar_black">
      <color rgba="0.05 0.05 0.05 1.0"/>
    </material>

    <link name="laser_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.19"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <origin xyz="0 0 -0.057" rpy="-1.5708 0 3.1416"/>
        <geometry>
          <mesh filename="package://rover_description/meshes/navigation/lidar/rplidar_s2.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="lidar_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.0385" length="0.039"/>
        </geometry>
      </collision>
    </link>

    <joint name="laser_joint" type="fixed">
      <parent link="main_body_link"/>
      <child link="laser_link"/>
      <origin xyz="0 0 0.17" rpy="0 0 0"/>
    </joint>

    <!-- Only include the Gazebo sensor block when simulation/publishing is desired -->
    <xacro:if value="${simulate_scan}">
      <gazebo reference="laser_link">
        <sensor type="gpu_lidar" name="generic_laser">
          <update_rate>10.0</update_rate>
          <topic>/scan</topic>
          <gz_frame_id>laser_link</gz_frame_id>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.141592</min_angle>
                <max_angle>3.141592</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.05</min>
              <max>18.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>
      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>