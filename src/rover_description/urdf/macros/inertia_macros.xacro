<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Solid box, centered on origin -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia
      ixx="${m / 12.0 * (y*y + z*z)}" ixy="0" ixz="0"
      iyy="${m / 12.0 * (x*x + z*z)}" iyz="0"
      izz="${m / 12.0 * (x*x + y*y)}"/>
  </xacro:macro>

  <!-- Solid cylinder, axis along local Z, centered on origin -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia
      ixx="${m / 12.0 * (3.0*r*r + h*h)}" ixy="0" ixz="0"
      iyy="${m / 12.0 * (3.0*r*r + h*h)}" iyz="0"
      izz="${m / 2.0 * r*r}"/>
  </xacro:macro>

  <!-- Solid sphere, centered on origin -->
  <xacro:macro name="sphere_inertia" params="m r">
    <inertia
      ixx="${2.0/5.0 * m * r*r}" ixy="0" ixz="0"
      iyy="${2.0/5.0 * m * r*r}" iyz="0"
      izz="${2.0/5.0 * m * r*r}"/>
  </xacro:macro>

</robot>