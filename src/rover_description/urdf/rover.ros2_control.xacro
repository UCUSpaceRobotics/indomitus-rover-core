<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <ros2_control name="RoverHardware" type="system">
    <hardware>
      <xacro:if value="$(arg use_sim)">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg use_sim)">
        <plugin>rover_hardware_interface/RoverHardwareInterface</plugin>
        <param name="can_interface">$(arg can_interface)</param>
        <param name="steer_ids">11 13 17 15</param>
        <param name="drive_ids">10 12 16 14</param>
        <param name="lifecycle_initial_state">inactive</param>
      </xacro:unless>
    </hardware>

    <joint name="fl_wheel_mount_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="fr_wheel_mount_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="bl_wheel_mount_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="br_wheel_mount_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <joint name="fl_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="bl_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="br_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>


  <xacro:if value="$(arg use_sim)">
    <ros2_control name="DiffBarHardware" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="l_rocker_joint">
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="r_rocker_joint">
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:if>

</robot>