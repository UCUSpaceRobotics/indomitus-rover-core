<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_fake_hardware" default="true"/>
  <xacro:arg name="end_effector" default="jaw"/>
  <xacro:arg name="sim" default="false"/>
  <!-- When the arm is mounted into another robot's URDF (e.g. the rover, see
       rover_description's mount_arm arg) that outer URDF already adds its
       own single gz_ros2_control-system plugin covering every <ros2_control>
       block in the combined model. Set this to false in that case so the
       arm doesn't register a second, redundant controller_manager plugin
       for the same Gazebo model. Standalone arm sim (arm_sim) leaves this
       at the default so it keeps adding its own plugin as before. -->
  <xacro:arg name="standalone_gz_plugin" default="true"/>
  <!-- camera:=false drops the simulated camera sensor (the URDF link and
       frames stay). Camera rendering is the main real-time-factor cost
       when the GPU isn't doing the rendering. -->
  <xacro:arg name="camera" default="true"/>

  <xacro:macro name="indomitus_arm" params="parent_link *origin">

    <xacro:property name="mesh_path" value="package://arm_description/meshes"/>
    <xacro:property name="stl_scale" value="0.001 0.001 0.001"/>

    <material name="light_grey">
      <color rgba="0.7 0.7 0.7 1.0"/>
    </material>

    <xacro:macro name="dummy_inertia" params="mass">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </xacro:macro>

    <joint name="arm_mount_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent_link}"/>
      <child link="arm_mount_link"/>
    </joint>

    <link name="arm_mount_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/arm_mount_v2.stl" scale="${stl_scale}"/></geometry>
        <material name="light_grey"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/arm_mount_v2.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="1.0"/>
    </link>

    <joint name="arm_mount_base_joint" type="revolute">
      <parent link="arm_mount_link"/>
      <child link="arm_base_link"/>
      <origin xyz="0.06 0 0.021" rpy="0 0 0"/> 
      <axis xyz="0 0 1"/>
      <limit lower="${-pi}" upper="${pi}" effort="100.0" velocity="1.0"/>
    </joint>

    <link name="arm_base_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/arm_base_v2.stl" scale="${stl_scale}"/></geometry>
        <material name="light_grey"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/arm_base_v2.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="2.0"/>
    </link>

    <joint name="arm_base_shoulder_joint" type="revolute">
      <parent link="arm_base_link"/>
      <child link="arm_shoulder_link"/>
      <origin xyz="-0.040366 -0.000325 0.103" rpy="${pi/3} 0 ${-pi}"/>
      <axis xyz="1 0 0"/>
      <limit lower="${-pi}" upper="${pi}" effort="100.0" velocity="1.0"/>
    </joint>

    <link name="arm_shoulder_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/arm_shoulder_v2.stl" scale="${stl_scale}"/></geometry>
        <material name="light_grey"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/arm_shoulder_v2.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="1.5"/>
    </link>

    <joint name="arm_shoulder_forearm_joint" type="revolute">
      <parent link="arm_shoulder_link"/>
      <child link="arm_forearm_link"/>
      <origin xyz="0 0.3 0" rpy="${5*pi/12} 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="${-pi/2}" upper="${pi/2}" effort="100.0" velocity="1.0"/>
    </joint>

    <link name="arm_forearm_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/arm_forearm_v2.stl" scale="${stl_scale}"/></geometry>
        <material name="light_grey"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/arm_forearm_v2.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="1.0"/>
    </link>

    <joint name="arm_forearm_wrist_1_joint" type="revolute">
      <parent link="arm_forearm_link"/>
      <child link="arm_wrist_1_link"/>
      <origin xyz="-0.0173 0.3 0" rpy="0 ${pi/2} 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-pi/2}" upper="${pi/2}" effort="100.0" velocity="1.0"/>
    </joint>

    <link name="arm_wrist_1_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/arm_wrist_v2.stl" scale="${stl_scale}"/></geometry>
        <material name="light_grey"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/arm_wrist_v2.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="0.5"/>
    </link>

    <joint name="arm_wrist_1_wrist_2_joint" type="revolute">
      <parent link="arm_wrist_1_link"/>
      <child link="arm_wrist_2_link"/>
      <origin xyz="0.0323 0 -0.035" rpy="${-pi/2} 0 ${pi/2}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-pi}" upper="${pi}" effort="100.0" velocity="1.0"/>
    </joint>

    <link name="arm_wrist_2_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/arm_wrist_v2.stl" scale="${stl_scale}"/></geometry>
        <material name="light_grey"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/arm_wrist_v2.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="0.3"/>
    </link>

    <joint name="arm_wrist_2_end_effector_joint" type="revolute">
      <parent link="arm_wrist_2_link"/>
      <child link="arm_end_effector_link"/>
      <origin xyz="0.0323 0 -0.035" rpy="${-pi/2} ${pi/2} ${-pi/2}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-pi}" upper="${pi}" effort="100.0" velocity="1.0"/>
    </joint>

    <link name="arm_end_effector_link">
      <xacro:if value="${'$(arg end_effector)' == 'jaw'}">
        <visual>
          <geometry><mesh filename="${mesh_path}/arm_jaw_gripper_v3.stl" scale="${stl_scale}"/></geometry>
          <material name="light_grey"/>
        </visual>
        <collision>
          <geometry><mesh filename="${mesh_path}/arm_jaw_gripper_v3.stl" scale="${stl_scale}"/></geometry>
        </collision>
      </xacro:if>
      
      <xacro:if value="${'$(arg end_effector)' == 'other_tool'}">
      </xacro:if>

      <xacro:dummy_inertia mass="0.2"/>
    </link>

    <xacro:if value="${'$(arg end_effector)' == 'jaw'}">
      <!-- v3: no CAD dimension doc available (unlike v2 above). Derived from
           the STL geometry itself: arm_jaw_gripper_finger_v3.stl is exported
           in the gripper's own assembly frame (same frame as
           arm_jaw_gripper_v3.stl), not in a per-part local frame like v2 was.
           Its bbox (X[-48.83,11] Y[-16.91,14.08] Z[53,161.52]mm) already sits
           correctly relative to the body bbox (Z[0,76]mm, overlap 53-76mm =
           mechanism recessed into the body, 76-161.5mm = fingers protruding)
           when placed with a plain identity origin. Stroke has no v3 source
           of truth yet, kept at the v2 value pending visual confirmation of
           open/close range in sim.

           finger_x_closed is NOT zero, unlike the rest: mirroring the mesh
           180 deg about Z at a plain (0,0,0) origin left a real 31.55mm gap
           between the two finger surfaces at rest (measured as the true
           nearest-neighbor distance between arm_jaw_gripper_finger_v3.stl's
           own vertex cloud and its mirrored copy, not just a bbox estimate,
           which undercounted it); closed did not mean touching. Each side
           is shifted inward by half that gap (15.775mm). A deliberate
           overlap (0.016, ~0.45mm interference) was tried first for a
           solid-looking contact, but under real Gazebo physics (not the
           fake-hardware mock, which has no collision checking) the
           interpenetrating collision meshes deadlocked the prismatic
           joint against its own contact force and the gripper could not
           open at all — confirmed by commanding gripper_controller with
           the arm actually spawned in gz-sim and watching /joint_states
           stay pinned at 0. 0.0155 leaves a ~0.55mm gap instead: visually
           still reads as closed, but with no interpenetration to jam on. -->
      <xacro:property name="finger_x_closed" value="0.0155"/>
      <xacro:property name="finger_stroke" value="0.012"/>
      <xacro:property name="finger_z" value="0.0"/>
      <xacro:property name="finger_right_y" value="0.0"/>
      <xacro:property name="finger_left_y" value="0.0"/>

      <xacro:macro name="jaw_gripper_finger" params="side x_closed y yaw axis_sign limit_lower limit_upper">
        <joint name="arm_jaw_gripper_finger_${side}_joint" type="prismatic">
          <parent link="arm_end_effector_link"/>
          <child link="arm_jaw_gripper_finger_${side}_link"/>
          <origin xyz="${x_closed} ${y} ${finger_z}" rpy="0 0 ${yaw}"/>
          <axis xyz="${axis_sign} 0 0"/>
          <limit lower="${limit_lower}" upper="${limit_upper}" effort="20.0" velocity="0.05"/>
          <xacro:unless value="${side == 'right'}">
            <!-- Right and left are mirror images (180 deg about Z), so their axes
                 point opposite ways in the parent frame — multiplier=-1.0 makes
                 them slide apart symmetrically as the right joint opens, rather
                 than translating together with a fixed gap. -->
            <mimic joint="arm_jaw_gripper_finger_right_joint" multiplier="-1.0" offset="0.0"/>
          </xacro:unless>
        </joint>

        <link name="arm_jaw_gripper_finger_${side}_link">
          <visual>
            <geometry><mesh filename="${mesh_path}/arm_jaw_gripper_finger_v3.stl" scale="${stl_scale}"/></geometry>
            <material name="light_grey"/>
          </visual>
          <collision>
            <geometry><mesh filename="${mesh_path}/arm_jaw_gripper_finger_v3.stl" scale="${stl_scale}"/></geometry>
          </collision>
          <xacro:dummy_inertia mass="0.05"/>
        </link>
      </xacro:macro>

      <!-- Same part mounted twice: "left" is the "right" finger rotated 180 deg about Z,
           so both slide outward along their own local +X (axis) to open — no mirrored mesh needed. -->
      <xacro:jaw_gripper_finger side="right" x_closed="${finger_x_closed}"  y="${finger_right_y}" yaw="0"      axis_sign="-1" limit_lower="0"                limit_upper="${finger_stroke}"/>
      <xacro:jaw_gripper_finger side="left"  x_closed="${-finger_x_closed}" y="${finger_left_y}"  yaw="${pi}" axis_sign="1"  limit_lower="${-finger_stroke}" limit_upper="0"/>
    </xacro:if>

    <joint name="arm_tcp_joint" type="fixed">
      <parent link="arm_end_effector_link"/>
      <child link="arm_tcp_link"/>
      
      <xacro:if value="${'$(arg end_effector)' == 'jaw'}">
        <!-- v3: X=Y=0 by construction (right/left fingers are the same mesh
             mirrored 180 deg about Z through the shared origin, see the
             finger properties comment above, so that origin is the natural
             symmetric grasp centerline). Z = max Z of
             arm_jaw_gripper_finger_v3.stl (161.5187mm, fingertip reach in
             the shared assembly frame); same derivation the old v2 value
             used (finger_z + finger local Z max), simplified here since
             finger_z is now 0. -->
        <origin xyz="0 0 0.1615" rpy="0 0 0"/>
      </xacro:if>
      
      <xacro:if value="${'$(arg end_effector)' != 'jaw'}">
        <origin xyz="0 -0.23 0" rpy="0 0 0"/>
      </xacro:if>
    </joint>

    <link name="arm_tcp_link"/> 

    <joint name="arm_camera_joint" type="fixed">
      <parent link="arm_end_effector_link"/>
      <child link="arm_camera_link"/>
      <!-- Ground truth click on the mount recess: (2.47, 21.72, 23.86)mm
           surface point (see history above/git log for the RViz Publish
           Point capture). Y is offset from that surface point by the
           box's own half-extent along the axis that actually faces this
           direction: arm_camera_link's local Z maps to global -Y here (see
           the rpy below, unchanged throughout), and local Z is the box's
           HEIGHT dimension (third size number below); keep this offset
           at HALF THE CURRENT HEIGHT whenever that size number changes, or
           the box either gaps off the surface or buries into it. Currently
           0.05m tall -> 25mm half-extent -> Y = 21.72 + 25 = 46.72mm. -->
      <origin xyz="0.00247 0.04672 0.02386" rpy="0 ${-pi/2} ${pi/2}"/>
    </joint>

    <link name="arm_camera_link">
      <visual>
        <geometry>
          <box size="0.035 0.035 0.05"/>
        </geometry>
        <material name="camera_blue">
          <color rgba="0.0 0.0 1.0 1.0"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <box size="0.035 0.035 0.05"/>
        </geometry>
      </collision>
    </link>

    <joint name="arm_camera_optical_joint" type="fixed">
      <parent link="arm_camera_link"/>
      <child link="arm_camera_optical_frame"/>
      <!-- 0.045 was sized for the old 60mm camera box (half-extent 30mm)
           and never revisited when the box shrank to 35mm; it put the
           lens 45mm out along camera_link's local +X (= +Z in
           arm_end_effector_link), landing deep inside the v3 gripper body
           instead of at the box's own front face. An actual captured
           /camera/image_raw frame confirmed this: flat solid grey, the lens
           pressed against the body's own material. Set to 0.0175, the
           current box's half-extent, so the lens sits flush with its front
           face instead of floating 27.5mm past it. rpy confirmed 180 deg
           rolled from a live captured frame (fingers rendered correctly
           shaped but upside down); flipping the sign of roll and yaw
           (pitch stays 0) is an exact 180 deg roll about the optical Z
           (viewing) axis: verified by matrix multiplication that the
           combined camera_joint*optical_joint rotation keeps the same +Z
           forward direction with X/Y both negated, not a re-aim. -->
      <origin xyz="0.0175 0 0" rpy="${pi/2} 0 ${pi/2}"/>
    </joint>

    <link name="arm_camera_optical_frame"/>

    <ros2_control name="ArmSystem" type="system">
      <hardware>
        <xacro:if value="$(arg sim)">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="$(arg sim)">
          <xacro:if value="$(arg use_fake_hardware)">
            <plugin>mock_components/GenericSystem</plugin>
          </xacro:if>
          <xacro:unless value="$(arg use_fake_hardware)">
            <plugin>arm_hardware_interface/ArmCanSystem</plugin>
            <param name="can_interface">can0</param>
            <!-- Stiffness ramps 0 -> 100% over this many seconds after activation -->
            <param name="gain_ramp_secs">15.0</param>
            <!-- Hard rate limiter on outgoing position commands (rad/s) —
                 even a wrong/hostile command can't move a joint faster than this. -->
            <param name="max_cmd_speed_rad_s">1.0</param>
            <!-- Activation aborts if any motor is silent for this long -->
            <param name="feedback_timeout_secs">2.0</param>
            <param name="gravity_ff_enabled">true</param>
            <!-- ~3.8 kg hangs below the shoulder with its COM ~0.3 m out, so the
                 holding torque there reaches ~11 Nm on extended poses. The two
                 motor families are an order of magnitude apart: Steadywin is
                 rated 48 Nm, Damiao only 9 Nm continuous. -->
            <param name="gravity_ff_max_nm_steadywin">20.0</param>
            <param name="gravity_ff_max_nm_damiao">6.0</param>
          </xacro:unless>
        </xacro:unless>
      </hardware>
      <!-- ======================= CALIBRATION =======================
           direction : +1 if pushing the joint in its URDF-positive direction
                       (right-hand rule about the <axis>) makes the RAW motor
                       angle increase; -1 otherwise.
           offset    : the RAW motor angle (rad) measured when the arm is
                       physically in the URDF zero pose. If you save the motor
                       zero (0xB1 / FF..FE) at that pose, offset = 0.0.
           kp / kd   : MIT gains, tuned on real hardware. The protocol packs
                       these into 12 bits over [0,500] and [0,5], and anything
                       above those is clamped silently — a kd of 6 reads back
                       as 5 with no warning anywhere.
           Re-verify with scripts/check_calibration.py (torqueless) after any
           mesh/geometry change that alters a joint's <axis>.
           ============================================================= -->
      <xacro:macro name="arm_joint_control" params="joint_name motor_id direction offset kp kd">
        <joint name="${joint_name}">
          <command_interface name="position">
            <param name="min">${-pi}</param>
            <param name="max">${pi}</param>
          </command_interface>
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <param name="motor_id">${motor_id}</param>
          <param name="direction">${direction}</param>
          <param name="offset">${offset}</param>
          <param name="kp">${kp}</param>
          <param name="kd">${kd}</param>
        </joint>
      </xacro:macro>

      <!-- MIT gains: protocol max kp=500, kd=5. Steadywin at ceiling to hold
           gravity; Damiao a step below to reduce wrist oscillation while stiff. -->
      <xacro:arm_joint_control joint_name="arm_mount_base_joint"          motor_id="20" direction="-1" offset="0.0"  kp="500.0" kd="5.0"/>
      <xacro:arm_joint_control joint_name="arm_base_shoulder_joint"       motor_id="21" direction="1"  offset="0.0"  kp="500.0" kd="5.0"/>
      <xacro:arm_joint_control joint_name="arm_shoulder_forearm_joint"    motor_id="22" direction="-1" offset="0.0"  kp="500.0" kd="5.0"/>
      <xacro:arm_joint_control joint_name="arm_forearm_wrist_1_joint"     motor_id="23" direction="-1" offset="0.0"  kp="400.0" kd="5.0"/>
      <xacro:arm_joint_control joint_name="arm_wrist_1_wrist_2_joint"     motor_id="24" direction="-1" offset="0.0"  kp="400.0" kd="5.0"/>
      <xacro:arm_joint_control joint_name="arm_wrist_2_end_effector_joint" motor_id="25" direction="1"  offset="0.0"  kp="350.0" kd="5.0"/>

      <!-- Only the right finger needs an interface: left is a <mimic> of it.
           Excluded on real hardware — ArmCanSystem hardcodes NUM_JOINTS=6 and
           would fail with "Expected 6 joints, got 7"; the JawGripperStub
           component below covers that case instead. -->
      <xacro:if value="${('$(arg end_effector)' == 'jaw') and (('$(arg sim)' == 'true') or ('$(arg use_fake_hardware)' == 'true'))}">
        <joint name="arm_jaw_gripper_finger_right_joint">
          <command_interface name="position">
            <param name="min">0</param>
            <param name="max">${finger_stroke}</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:if>
    </ros2_control>

    <!-- There is no gripper motor on the real arm yet, but the finger joint must
         still report state: without it joint_state_broadcaster never publishes
         the joint, the planning scene monitor sees an incomplete robot state,
         and move_group/Servo silently refuse to move. GenericSystem echoes
         commands back as state, so the joint exists for MoveIt while nothing
         physical moves. Replace with the real gripper hardware plugin once the
         motor is wired up. -->
    <xacro:if value="${('$(arg end_effector)' == 'jaw') and ('$(arg sim)' == 'false') and ('$(arg use_fake_hardware)' == 'false')}">
      <ros2_control name="JawGripperStub" type="system">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
        </hardware>
        <joint name="arm_jaw_gripper_finger_right_joint">
          <command_interface name="position">
            <param name="min">0</param>
            <param name="max">${finger_stroke}</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
        </joint>
      </ros2_control>
    </xacro:if>

    <xacro:if value="$(arg sim)">
      <xacro:if value="$(arg standalone_gz_plugin)">
        <gazebo>
          <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find arm_sim)/config/ros2_controllers.yaml</parameters>
          </plugin>
        </gazebo>
      </xacro:if>

      <gazebo reference="arm_mount_link">
        <visual>
          <material>
            <ambient>0.7 0.7 0.7 1.0</ambient>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
      </gazebo>

      <gazebo reference="arm_base_link">
        <visual>
          <material>
            <ambient>0.7 0.7 0.7 1.0</ambient>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
      </gazebo>

      <gazebo reference="arm_shoulder_link">
        <visual>
          <material>
            <ambient>0.7 0.7 0.7 1.0</ambient>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
      </gazebo>

      <gazebo reference="arm_forearm_link">
        <visual>
          <material>
            <ambient>0.7 0.7 0.7 1.0</ambient>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
      </gazebo>

      <gazebo reference="arm_wrist_1_link">
        <visual>
          <material>
            <ambient>0.7 0.7 0.7 1.0</ambient>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
      </gazebo>

      <gazebo reference="arm_wrist_2_link">
        <visual>
          <material>
            <ambient>0.7 0.7 0.7 1.0</ambient>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
      </gazebo>

      <gazebo reference="arm_end_effector_link">
        <visual>
          <material>
            <ambient>0.7 0.7 0.7 1.0</ambient>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
      </gazebo>

      <xacro:if value="${'$(arg end_effector)' == 'jaw'}">
        <gazebo reference="arm_jaw_gripper_finger_right_link">
          <visual>
            <material>
              <ambient>0.7 0.7 0.7 1.0</ambient>
              <diffuse>0.7 0.7 0.7 1.0</diffuse>
              <specular>0.3 0.3 0.3 1.0</specular>
            </material>
          </visual>
        </gazebo>

        <gazebo reference="arm_jaw_gripper_finger_left_link">
          <visual>
            <material>
              <ambient>0.7 0.7 0.7 1.0</ambient>
              <diffuse>0.7 0.7 0.7 1.0</diffuse>
              <specular>0.3 0.3 0.3 1.0</specular>
            </material>
          </visual>
        </gazebo>
      </xacro:if>

      <xacro:if value="$(arg camera)">
      <gazebo reference="arm_camera_link">
        <sensor name="arm_camera" type="camera">
          <!-- This is the pose gz-sim actually renders from, separate
               from, and NOT driven by, arm_camera_optical_joint's TF chain
               (that joint only labels frame_id for ROS consumers via
               optical_frame_id below; editing its rpy alone was verified,
               via repeated live-captured /camera/image_raw frames, to have
               zero effect on the rendered image). X was the same stale
               0.045 (old 60mm box) bug as arm_camera_optical_joint had;
               fixed to 0.0175 (current box half-extent). Roll=pi added
               here to fix the confirmed 180 deg upside-down image. -->
          <pose>0.0175 0 0 3.14159265 0 0</pose>
          <camera>
            <optical_frame_id>arm_camera_optical_frame</optical_frame_id>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>15</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>arm_camera/image_raw</topic>
        </sensor>
      </gazebo>
      </xacro:if>
    </xacro:if>

  </xacro:macro>
</robot>
