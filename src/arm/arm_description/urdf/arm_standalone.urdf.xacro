<?xml version="1.0"?>
<robot name="indomitus_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Arm-only assembly. The world root fixes the model in Gazebo. -->
  <xacro:arg name="end_effector" default="jaw"/>

  <xacro:include filename="$(find arm_description)/urdf/arm_macro.xacro"/>

  <link name="world"/>

  <xacro:indomitus_arm parent_link="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:indomitus_arm>

  <!-- Its controller_manager lives under /arm, same as on hardware, and
       reads robot_description from /arm/robot_state_publisher. -->
  <xacro:if value="$(arg sim)">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <ros>
          <namespace>/arm</namespace>
        </ros>
        <parameters>$(find arm_sim)/config/ros2_controllers.yaml</parameters>
        <!-- Fraction of the position error Gazebo closes per step. 1.0 was
             needed while Servo re-anchored on the measured state every cycle
             (with 0.1 teleop crawled); since Servo streams JointTrajectory
             into the JTC (it integrates its own targets) 1.0 only made the
             joints jitter and overshoot, 0.3 tracks smoothly. Set here, not in
             the yaml: with two gz_ros2_control plugins in one model only the
             first plugin's params file reaches the ROS context. -->
        <position_proportional_gain>0.3</position_proportional_gain>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
