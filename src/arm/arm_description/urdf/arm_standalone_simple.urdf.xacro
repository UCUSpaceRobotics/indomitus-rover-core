<?xml version="1.0"?>
<robot name="indomitus_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="end_effector" default="jaw"/>

  <!-- Same arm as arm_standalone.urdf.xacro but with primitive geometry
       (boxes/cylinders) instead of the STL meshes — cheap to render, same
       joints, masses and inertias. Use this variant in Gazebo when camera
       rendering runs without GPU acceleration and the meshes tank the
       real-time factor. -->
  <xacro:include filename="$(find arm_description)/urdf/arm_macro_simple.xacro"/>

  <link name="world"/>

  <xacro:indomitus_arm parent_link="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:indomitus_arm>

</robot>
