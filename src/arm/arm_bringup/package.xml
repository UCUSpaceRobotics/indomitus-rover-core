<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_bringup</name>
  <version>0.0.0</version>
  <description>
    Bringup package for the Indomitus 6-DOF robotic arm.
    Provides launch files, hardware configurations, and control integration 
    specifically for the Arm sub-team.
  </description>
  <maintainer email="indomitus@ucu.edu.ua">UCUSpaceRobotics</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>arm_description</exec_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>

  <!-- Real top-level bringup (arm.launch.py): MoveIt + Servo + CAN peripherals
       + on-rover gamepad teleop. Fully headless — no rviz2/joint_state_publisher_gui
       anywhere in this package; those live only in arm_viz. -->
  <exec_depend>arm_moveit_config</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>arm_peripherals</exec_depend>
  <exec_depend>rover_bringup</exec_depend>
  <exec_depend>arm_teleop</exec_depend>
  <!-- collision_link_reporter (report_collisions:=true) only — arm_tasks is
       excluded from the Jetson production image (docker/Dockerfile's
       SIMULATION_PKGS), so arm.launch.py defaults report_collisions to
       false; this dependency is still correct/harmless to declare here. -->
  <exec_depend>arm_tasks</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>