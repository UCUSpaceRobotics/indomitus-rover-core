#!/bin/bash
# rover-mission - start/stop the rover's tmux sessions per mission, inside the rover container
# (dev and prod). At boot: system/systemd/rover-mission.service runs `rover-mission default`.
# From a laptop: scripts/mission.sh.
#
# Missions: ../missions/<mission>.conf - "session [can=IFACE] command" per line, in start order.
# Default:  ../default-mission - one line, written by --default (kept out of git and the deploy).
# The current mission and each session's command live in tmux: they go away with the sessions.
set -euo pipefail

ROBOT_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
MISSION_DIR=$ROBOT_DIR/missions
DEFAULT_FILE=$ROBOT_DIR/default-mission
SESSION=$ROBOT_DIR/scripts/rover-session

M_SESSIONS=()                  # load_mission: sessions in start order
declare -A M_CMD=() M_CAN=()   # load_mission: session -> command / CAN interface

die() { echo -e "\e[31m[ERROR]\e[0m $*" >&2; exit 1; }

missions() {
    local f
    for f in "$MISSION_DIR"/*.conf; do [[ -e $f ]] && basename "$f" .conf; done
}
is_mission() { [[ -f $MISSION_DIR/$1.conf ]]; }

load_mission() {
    local file="$MISSION_DIR/$1.conf" s first rest cmd can
    is_mission "$1" || die "Unknown mission '$1' ($(missions | xargs))"
    M_SESSIONS=(); M_CMD=(); M_CAN=()
    while read -r s first rest; do
        [[ -z $s || $s == \#* ]] && continue
        if [[ $first == can=* ]]; then can=${first#can=}; cmd=$rest; else can=; cmd="$first${rest:+ $rest}"; fi
        cmd=${cmd%%[[:space:]]#*}; cmd=${cmd%"${cmd##*[![:space:]]}"}   # drop " # comment", trailing spaces
        [[ -n $cmd ]] || die "$file: no command for '$s'"
        M_SESSIONS+=("$s"); M_CMD[$s]=$cmd; M_CAN[$s]=$can
    done < "$file"
}

# Sessions started by rover-session (others, e.g. your own `sim`, are never touched).
managed() {
    local s
    for s in $(tmux ls -F '#S' 2>/dev/null); do
        [[ -n $("$SESSION" command "$s") ]] && echo "$s"
    done
}
is_running() { local fg; fg=$("$SESSION" status "$1"); [[ $fg != - && $fg != bash ]]; }

start() {   # start SESSION CAN CMD
    echo ">>> start $1${2:+ (waits for $2)}: $3"
    "$SESSION" start "$1" ${2:+"can=$2"} "$3"
}

apply() {
    local mission=$1 s
    load_mission "$mission"

    # Stop first, in parallel: frees CAN / cameras before anything new grabs them.
    for s in $(managed); do
        [[ -v M_CMD[$s] ]] && continue
        echo ">>> stop $s"; "$SESSION" stop "$s" &
    done
    wait

    for s in "${M_SESSIONS[@]}"; do
        if is_running "$s" && [[ $("$SESSION" command "$s") == "${M_CMD[$s]}" && $("$SESSION" can "$s") == "${M_CAN[$s]}" ]]; then
            echo ">>> $s already running"; continue
        fi
        start "$s" "${M_CAN[$s]}" "${M_CMD[$s]}"
    done
    tmux set -g @rover_mission "$mission"
}

stop_all() {
    local s
    for s in $(managed); do echo ">>> stop $s"; "$SESSION" stop "$s" & done
    wait
    tmux set -gu @rover_mission 2>/dev/null || true
}

status() {
    local s mission default
    mission=$(tmux show -gv @rover_mission 2>/dev/null || true)
    default=$(cat "$DEFAULT_FILE" 2>/dev/null || true)
    echo "mission: ${mission:--}   default (boot): ${default:--}"
    [[ -n $mission ]] && is_mission "$mission" && load_mission "$mission"
    printf "%-10s %-14s %s\n" SESSION RUNS COMMAND
    for s in $( { printf '%s\n' "${M_SESSIONS[@]}"; managed; } | awk 'NF && !seen[$0]++'); do
        printf "%-10s %-14s %s\n" "$s" "$("$SESSION" status "$s")" "$("$SESSION" command "$s")"
    done
}

list() {
    local m s
    for m in $(missions); do
        load_mission "$m"
        echo "$m:"
        for s in "${M_SESSIONS[@]}"; do
            printf "  %-10s %-14s %s\n" "$s" "${M_CAN[$s]:+can=${M_CAN[$s]}}" "${M_CMD[$s]}"
        done
    done
}

show_help() {
    cat << EOF
Usage: rover-mission COMMAND

  MISSION [--default]   start the mission's sessions, stop the other rover sessions;
                        running ones with the same command are left alone.
                        --default: also the one 'default' starts (at boot)
  default               start the default mission (rover-mission.service at boot)
  stop                  stop every rover session
  restart SESSION...    restart these with their current command
  enter SESSION [-r]    attach (-r: read-only); detach with Ctrl-b d
  status                current / default mission, what runs in each session
  list                  missions ($MISSION_DIR)

Missions: $(missions | xargs)
EOF
}

[[ $# -gt 0 ]] || { show_help; exit 1; }
cmd=$1; shift
case $cmd in
    -h|--help|help) show_help;;
    status)  status;;
    list)    list;;
    stop)    stop_all;;
    enter)   [[ $# -ge 1 ]] || die "enter needs a SESSION"; exec "$SESSION" enter "$@";;
    default)
        [[ -f $DEFAULT_FILE ]] || { echo ">>> no default mission ($DEFAULT_FILE) - nothing started"; exit 0; }
        apply "$(head -1 "$DEFAULT_FILE" | tr -d '[:space:]')";;
    restart)
        [[ $# -ge 1 ]] || die "restart needs SESSION(s)"
        for s in "$@"; do [[ -n $("$SESSION" command "$s") ]] || die "'$s' wasn't started by rover-mission / rover-session"; done
        for s in "$@"; do start "$s" "$("$SESSION" can "$s")" "$("$SESSION" command "$s")"; done;;
    *)
        is_mission "$cmd" || die "Unknown command or mission '$cmd' (missions: $(missions | xargs); -h for help)"
        default=false
        [[ ${1:-} == --default ]] && { default=true; shift; }
        [[ $# -eq 0 ]] || die "Unexpected: $*"
        apply "$cmd"
        if [[ $default == true ]]; then
            echo "$cmd" > "$DEFAULT_FILE"
            echo ">>> '$cmd' is the default mission"
        fi;;
esac
