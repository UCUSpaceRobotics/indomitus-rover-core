<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Single source of the arm mount pose on the rover. Both
       arm_on_rover.urdf.xacro (/arm robot_state_publisher) and
       indomitus_gz.urdf.xacro (Gazebo model) mount the arm through this
       macro, so TF and physics always agree. -->

  <!-- Checked by eye against the real rover; the base sitting inside the
       main body box is expected. -->
  <xacro:property name="arm_mount_xyz" value="0.17 0 0.12"/>
  <xacro:property name="arm_mount_rpy" value="0 0 0"/>

  <xacro:include filename="$(find arm_description)/urdf/arm_macro.xacro"/>

  <xacro:macro name="indomitus_arm_on_rover">
    <xacro:indomitus_arm parent_link="main_body_link">
      <origin xyz="${arm_mount_xyz}" rpy="${arm_mount_rpy}"/>
    </xacro:indomitus_arm>
  </xacro:macro>
</robot>
