<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>indomitus_bringup</name>
  <version>0.0.0</version>
  <description>
    Entry points that run the rover and the arm together, e.g. the arm
    mounted on the rover in one Gazebo model.
  </description>
  <maintainer email="indomitus@ucu.edu.ua">UCUSpaceRobotics</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>

  <exec_depend>indomitus_description</exec_depend>
  <exec_depend>rover_description</exec_depend>
  <exec_depend>rover_sim</exec_depend>
  <exec_depend>rover_bringup</exec_depend>
  <exec_depend>rover_power</exec_depend>
  <exec_depend>arm_description</exec_depend>
  <exec_depend>arm_sim</exec_depend>
  <exec_depend>arm_bringup</exec_depend>

  <!-- Optional switch panel (spawn_panel:=true) -->
  <exec_depend>panel_description</exec_depend>
  <exec_depend>panel_sim</exec_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
