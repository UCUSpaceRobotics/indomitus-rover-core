<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_teleop</name>
  <version>0.0.0</version>
  <description>
    Core control package for the Indomitus rover. Contains nodes for 
    joystick command interpretation, kinematics calculation, 
    and wheel-odometry estimation.
  </description>
  <maintainer email="indomitus@ucu.edu.ua">UCUSpaceRobotics</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>

  <!-- Messages types -->
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>python3-numpy</depend>

  <depend>indomitus_interfaces</depend>
  <depend>controller_manager_msgs</depend>
  <depend>lifecycle_msgs</depend>

  <!-- URDF Decsription -->
  <depend>xacro</depend>

  <!-- ROS2 Control -->
  <depend>ros2_control</depend>
  <depend>ros2_controllers</depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>