<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_power</name>
  <version>0.0.0</version>
  <description>
    Owner of the rover's drive power: switches the RoverHardware component and
    the swerve controller together, compact mode, clearing drive faults, and
    publishes drive/state. Used by the onboard joystick and the ground station
    alike; runs on the rover in hardware and in simulation.
  </description>
  <maintainer email="indomitus@ucu.edu.ua">UCUSpaceRobotics</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>indomitus_interfaces</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
