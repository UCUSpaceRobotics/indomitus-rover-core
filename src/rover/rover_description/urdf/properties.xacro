<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== MATH HELPERS ===================== -->
  <xacro:property name="M_PI" value="${pi}"/>
  <xacro:property name="M_PI_2" value="${pi / 2.0}"/>

  <!-- ===================== CHASSIS LAYOUT ===================== -->
  <xacro:property name="wheelbase" value="0.797"/>     <!-- front-to-rear axle distance -->
  <xacro:property name="track_width" value="0.644"/>   <!-- left-to-right rocker pivot distance -->

  <!-- ===================== MAIN BODY ===================== -->
  <xacro:property name="body_length" value="0.603"/>   <!-- X -->
  <xacro:property name="body_width" value="0.583"/>    <!-- Y -->
  <xacro:property name="body_height" value="0.246"/>   <!-- Z -->
  <xacro:property name="body_mass" value="40.0"/>

  <!-- ===================== SUSPENSION BASE AXII ===================== -->
  <xacro:property name="axii_length" value="0.1"/>
  <xacro:property name="axii_width" value="0.68"/>
  <xacro:property name="axii_height" value="0.05"/>
  <xacro:property name="axii_mass" value="0.5"/>

  <!-- ===================== ROCKER ===================== -->
  <!-- Geometry -->
  <xacro:property name="rocker_length" value="0.902"/>  <!-- X -->
  <xacro:property name="rocker_width" value="0.0995"/>  <!-- Y -->
  <xacro:property name="rocker_height" value="0.187"/>  <!-- Z -->
  <xacro:property name="rocker_mass" value="1.0"/>

  <!-- Mesh alignment: centers rocker.stl on the rocker link's own origin. The left
       rocker's mesh is yawed 180 deg, so its Y correction is not a mirror of the right. -->
  <xacro:property name="rocker_mesh_align_y_left" value="-0.02"/>
  <xacro:property name="rocker_mesh_align_y_right" value="0.02"/>

  <!-- Wheel-mount attachment point: where the wheel_mount hub attaches to the rocker's end,
       relative to the rocker's pivot origin -->
  <!-- Lateral offset stays 0: the steering axis and wheel centre sit on the rocker
       pivot plane, so wheel centres land at +/-track_width/2, which is what
       swerve_kinematics and the odometry in controllers.yaml assume. -->
  <xacro:property name="rocker_mount_x_offset" value="0.050"/>
  <xacro:property name="rocker_hub_y" value="0.0"/>
  <xacro:property name="rocker_hub_z" value="-0.1140"/>

  <!-- ===================== WHEEL MOUNT (steering knuckle) ===================== -->
  <!-- Geometry -->
  <xacro:property name="wheel_mount_length" value="0.150"/>
  <xacro:property name="wheel_mount_width" value="0.144"/>
  <xacro:property name="wheel_mount_height" value="0.274"/>
  <xacro:property name="wheel_mount_mass" value="0.162"/>

  <!-- Mesh alignment: centers wheel_mount.stl's steering bore on the link's own origin -->
  <xacro:property name="wheel_mount_hub_offset" value="0.1489"/>
  <xacro:property name="wheel_mount_visual_z" value="-0.1799"/>

  <!-- Wheel attachment point: axle position relative to the steering bore -->
  <xacro:property name="wheel_mount_drop" value="0.1857"/>
  <xacro:property name="axle_lateral_offset" value="0.0"/>

  <!-- ===================== WHEEL ===================== -->
  <!-- Geometry -->
  <xacro:property name="wheel_radius" value="0.156"/>
  <xacro:property name="wheel_width" value="0.12"/>
  <xacro:property name="wheel_mass" value="0.5"/>

  <!-- Mesh alignment: centers wheel.stl on the wheel link's own origin -->
  <xacro:property name="wheel_hub_offset" value="0.151"/>

  <!-- ===================== BASE GROUND CLEARANCE ===================== -->
  <!-- Height of base_link above ground level (base_footprint), derived from the
       suspension/wheel stack-up at the nominal rest pose (rocker angle = 0,
       steering angle = 0): rocker pivot -> wheel-mount hub (-rocker_hub_z),
       wheel-mount hub -> axle (wheel_mount_drop), axle -> ground (wheel_radius).
       Not consumed anywhere in this xacro tree; it's the source of truth for
       the `ground_height` parameter passed to tilt_broadcaster_node in
       rover_localization/launch/ekf.launch.py; update that parameter to match
       if this value changes. -->
  <xacro:property name="base_link_ground_height" value="${wheel_radius - rocker_hub_z + wheel_mount_drop}"/>

  <!-- ===================== JOINT LIMITS ===================== -->
  <xacro:property name="steering_limit" value="${3.0 * pi / 2.0}"/>  <!-- +/-270 deg -->
  <xacro:property name="steering_effort" value="500"/>
  <xacro:property name="steering_velocity" value="2"/>

  <xacro:property name="drive_effort" value="100"/>
  <xacro:property name="drive_velocity" value="10"/>

  <!-- ===================== WHEEL GROUND CONTACT FRICTION ===================== -->
  <xacro:property name="wheel_mu1" value="1.2"/>
  <xacro:property name="wheel_mu2" value="1.2"/>
  <xacro:property name="wheel_kp" value="1000000.0"/>
  <xacro:property name="wheel_kd" value="1.0"/>

  <!-- ===================== ZED2I POSSITION ===================== -->
  <xacro:property name="zed2i_x" value="${body_length / 2.0 + 0.05}"/>
  <xacro:property name="zed2i_y" value="0.0"/>
  <xacro:property name="zed2i_z" value="${body_height / 2.0 - 0.07}"/>

  <xacro:property name="zed2i_rx" value="0.0"/>
  <xacro:property name="zed2i_ry" value="${radians(37)}"/>
  <xacro:property name="zed2i_rz" value="0.0"/>

  <!-- ===================== CAMERA MAST ===================== -->
  <!-- Vertical 2x2 cm pole on the rear face of the main body, 1 m tall, its bottom
       level with the body's bottom. Centred left-right: CALIBRATE (measure). -->
  <xacro:property name="mast_size" value="0.02"/>
  <xacro:property name="mast_height" value="1.0"/>
  <xacro:property name="mast_mass" value="0.3"/>
  <xacro:property name="mast_x" value="${-body_length / 2.0 - mast_size / 2.0}"/>
  <xacro:property name="mast_y" value="0.0"/>
  <xacro:property name="mast_z" value="${-body_height / 2.0 + mast_height / 2.0}"/>

  <!-- ===================== USB CAMERAS (rover_cameras) ===================== -->
  <!-- Hand-measured mounting poses, relative to the parent link's origin; pitch > 0
       looks down. Every value marked CALIBRATE is a tape-measure estimate to replace
       with an extrinsic calibration (grep CALIBRATE). -->

  <!-- arducam-fr-bottom: under the main body, 15 cm forward of its centre, 3 cm below
       its bottom, looking forward 15 deg down. CALIBRATE: y (assumed centred), z, pitch. -->
  <xacro:property name="arducam_fr_bottom_x" value="0.15"/>
  <xacro:property name="arducam_fr_bottom_y" value="0.0"/>
  <xacro:property name="arducam_fr_bottom_z" value="${-body_height / 2.0 - 0.03}"/>
  <xacro:property name="arducam_fr_bottom_pitch" value="${15.0 * pi / 180.0}"/>

  <!-- arducam-mast: on the mast (relative to mast_link, the pole's centre), 5 cm
       below its top, 2 cm to the left of the pole, looking forward 25 deg down.
       CALIBRATE: y (2 cm from the pole's axis assumed), x, pitch. -->
  <xacro:property name="arducam_mast_x" value="0.0"/>
  <xacro:property name="arducam_mast_y" value="0.02"/>
  <xacro:property name="arducam_mast_z" value="${mast_height / 2.0 - 0.05}"/>
  <xacro:property name="arducam_mast_pitch" value="${25.0 * pi / 180.0}"/>

  <!-- ===================== LIDAR POSSITION ===================== -->
  <xacro:property name="lidar_x" value="0.0"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z" value="${body_height / 2.0 + 0.07}"/>
</robot>