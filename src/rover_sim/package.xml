<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_sim</name>
  <version>0.0.0</version>
  <description>
    Simulation package for the Indomitus rover, 
    including Gazebo world, URDF, controllers 
    and ROS-Gazebo bridge configuration.
  </description>
  <maintainer email="indomitus@ucu.edu.ua">UCUSpaceRobotics</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>pluginlib</depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>

  <!-- Interfaces -->
  <depend>geometry_msgs</depend>

  <!-- Launch infrastructure -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Internal packages -->
  <exec_depend>rover_bringup</exec_depend>
  <exec_depend>rover_description</exec_depend>
  <exec_depend>rover_localization</exec_depend>

  <!-- sim_gz_full.launch.py: combined rover + arm + panel -->
  <exec_depend>arm_description</exec_depend>
  <exec_depend>panel_description</exec_depend>
  <exec_depend>panel_sim</exec_depend>

  <!-- Simulation -->
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
