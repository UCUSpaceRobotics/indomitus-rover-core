<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>indomitus_rover_chassis_driver</name>
  <version>0.0.0</version>
  <description>
    ROS2 driver for all rover chassis motors:
    Steadywin steer motors (V3.06b0 custom CAN) and Damiao drive motors (MIT CAN).
    Handles motor initialization, control, feedback, and graceful shutdown.
  </description>
  <maintainer email="r.r006143@gmail.com">indomitus</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>can_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>indomitus_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
