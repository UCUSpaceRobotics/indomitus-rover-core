<?xml version="1.0"?>
<robot name="indomitus_panel" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find panel_description)/urdf/panel_macro.xacro"/>

  <!-- panel_x/y/z/yaw are declared for callers that pass them (e.g.
       arm_gazebo.launch.py's Command(...) invocation), but must NOT also
       be applied here: arm_gazebo.launch.py's ros_gz_sim spawn already
       places this model's root ("world" link) at that exact pose in
       Gazebo. Reapplying the same offset to panel_mount_joint here would
       place panel_base_link there A SECOND TIME, relative to the
       already-offset "world" link. Confirmed live via TF as an actual
       bug (panel_base_link ended up at a doubled offset/rotation from
       the intended spawn pose, ~1m and ~30 deg off). This joint's origin
       must stay identity; the physical/TF placement is the spawn
       command's job alone. -->
  <xacro:arg name="panel_x" default="0"/>
  <xacro:arg name="panel_y" default="0"/>
  <xacro:arg name="panel_z" default="0"/>
  <xacro:arg name="panel_yaw" default="0"/>

  <link name="world"/>

  <xacro:indomitus_panel parent_link="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:indomitus_panel>

</robot>
