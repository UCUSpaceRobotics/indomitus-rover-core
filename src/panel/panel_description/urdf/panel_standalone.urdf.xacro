<?xml version="1.0"?>
<robot name="indomitus_panel" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find panel_description)/urdf/panel_macro.xacro"/>

  <link name="world"/>

  <xacro:indomitus_panel parent_link="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:indomitus_panel>

</robot>
