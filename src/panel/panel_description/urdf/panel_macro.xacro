    <!-- ===================== BREAKER 16 (MCB_1P.stl) ===================== -->
    <!-- Single-pole miniature circuit breaker toggle, ~14x16x16 mm. -->
    <joint name="panel_breaker_16_joint" type="revolute">
      <parent link="panel_base_link"/>
      <child link="panel_breaker_16_link"/>
      <origin xyz="0.119393 0.000926 0.305081" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="${pi/3}" effort="5.0" velocity="2.0"/>
      <dynamics damping="0.02" friction="0.02"/>
    </joint>

    <link name="panel_breaker_16_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/MCB_1P.stl" scale="${stl_scale}"/></geometry>
        <material name="breaker_white"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/MCB_1P.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="0.01"/>
    </link>


    <!-- ===================== BREAKER 17 (MCB_1P.stl) ===================== -->
    <!-- Single-pole miniature circuit breaker toggle, ~14x16x16 mm. -->
    <joint name="panel_breaker_17_joint" type="revolute">
      <parent link="panel_base_link"/>
      <child link="panel_breaker_17_link"/>
      <origin xyz="0.137393 0.000926 0.305081" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="${pi/3}" effort="5.0" velocity="2.0"/>
      <dynamics damping="0.02" friction="0.02"/>
    </joint>

    <link name="panel_breaker_17_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/MCB_1P.stl" scale="${stl_scale}"/></geometry>
        <material name="breaker_white"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/MCB_1P.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="0.01"/>
    </link>


    <!-- ===================== INDICATOR LIGHTS (primitive, no STL) =====================
         Row of 5 status LEDs above the breaker row, per "All of the five
         indicators are lit up" in the Expected Results. No source mesh for
         these exists, so they're flat green boxes flush with the panel
         face — positioned/sized by eye against the reference render, same
         placeholder-until-verified caveat as everything else in this file. -->
    <xacro:macro name="panel_indicator" params="suffix x z">
      <joint name="panel_indicator_${suffix}_joint" type="fixed">
        <parent link="panel_base_link"/>
        <child link="panel_indicator_${suffix}_link"/>
        <origin xyz="${x} -0.003 ${z}" rpy="0 0 0"/>
      </joint>
      <link name="panel_indicator_${suffix}_link">
        <visual>
          <geometry><box size="0.022 0.004 0.014"/></geometry>
          <material name="indicator_green"/>
        </visual>
        <collision>
          <geometry><box size="0.022 0.004 0.014"/></geometry>
        </collision>
        <xacro:dummy_inertia mass="0.001"/>
      </link>
    </xacro:macro>

    <xacro:panel_indicator suffix="1" x="-0.119578" z="0.365"/>
    <xacro:panel_indicator suffix="2" x="-0.059789" z="0.365"/>
    <xacro:panel_indicator suffix="3" x="0"         z="0.365"/>
    <xacro:panel_indicator suffix="4" x="0.059789"  z="0.365"/>
    <xacro:panel_indicator suffix="5" x="0.119578"  z="0.365"/>


    <!-- ===================== SOCKETS (primitive, no STL) =====================
         The two IEC320 C14 plug sockets ("insert the plug into one of the
         two sockets"), placed left of the pink rotary power switches at the
         same row height (panel_main_switch_1/2 are at z=0.109905). Small
         grey cylinders standing proud of the panel face. -->
    <xacro:macro name="panel_socket" params="suffix x z">
      <joint name="panel_socket_${suffix}_joint" type="fixed">
        <parent link="panel_base_link"/>
        <child link="panel_socket_${suffix}_link"/>
        <origin xyz="${x} -0.006 ${z}" rpy="${pi/2} 0 0"/>
      </joint>
      <link name="panel_socket_${suffix}_link">
        <visual>
          <geometry><cylinder radius="0.012" length="0.012"/></geometry>
          <material name="socket_grey"/>
        </visual>
        <collision>
          <geometry><cylinder radius="0.012" length="0.012"/></geometry>
        </collision>
        <xacro:dummy_inertia mass="0.005"/>
      </link>
    </xacro:macro>

    <xacro:panel_socket suffix="1" x="-0.10" z="0.109905"/>
    <xacro:panel_socket suffix="2" x="-0.06" z="0.109905"/>


    <!-- ===================== ArUco MARKER MOUNTS (primitive, no STL) =====================
         Flat black squares for pose-detection markers ("AruCo detection"
         in the scoring sheet). Three of the four corners are marked in the
         reference render (top-left, top-right, bottom-left).

         Tag IDs (4X4_50 dictionary, matching rover_aruco/config/aruco_params.yaml's
         marker_dict): top_left=20, top_right=21, bottom_left=22. Chosen
         arbitrarily — nothing was previously assigned anywhere in this repo
         or on real hardware (see git history). Reassign freely here (and
         regenerate textures/aruco_tags/*.png + panel_perception's marker-ID
         params) if the real/competition panel ends up using different
         numbers. Generated via:
           cv2.aruco.drawMarker(cv2.aruco.Dictionary_get(cv2.aruco.DICT_4X4_50), <id>, 400)
         (OpenCV 4.5's legacy API — this workspace's opencv is 4.5.4, which
         predates the newer generateImageMarker() name.)

         In sim, the numbered pattern is a separate textured quad mesh
         (meshes/aruco_tags/panel_marker_<suffix>.obj+.mtl+.png) laid
         directly on top of the black mount box below — a first attempt
         using a PBR albedo-map <gazebo><material> override directly on
         the box primitive silently rendered as flat black (gz-sim's
         URDF-import path doesn't appear to carry that through), so this
         uses the same textured-mesh mechanism as any other visual mesh
         in this file instead, which is the well-supported path. -->
    <xacro:macro name="panel_marker" params="suffix x z">
      <joint name="panel_marker_${suffix}_joint" type="fixed">
        <parent link="panel_base_link"/>
        <child link="panel_marker_${suffix}_link"/>
        <origin xyz="${x} -0.003 ${z}" rpy="0 0 0"/>
      </joint>
      <link name="panel_marker_${suffix}_link">
        <visual>
          <geometry><box size="0.04 0.002 0.04"/></geometry>
          <material name="marker_black"/>
        </visual>
        <visual>
          <geometry><mesh filename="${mesh_path}/aruco_tags/panel_marker_${suffix}.obj"/></geometry>
        </visual>
        <collision>
          <geometry><box size="0.04 0.002 0.04"/></geometry>
        </collision>
        <xacro:dummy_inertia mass="0.001"/>
      </link>
    </xacro:macro>

    <xacro:panel_marker suffix="top_left"    x="-0.135" z="0.415"/>  <!-- ArUco id 20 -->
    <xacro:panel_marker suffix="top_right"   x="0.135"  z="0.415"/>  <!-- ArUco id 21 -->
    <xacro:panel_marker suffix="bottom_left" x="-0.135" z="0.035"/>  <!-- ArUco id 22 -->


    <xacro:if value="$(arg sim)">
      <!-- panel_base_link only: no gravity, so the board itself neither
           falls nor tips over on sloped terrain and just sits exactly at
           its spawn pose (see panel_x/y/z/yaw in sim_gz_full.launch.py).
           This means that pose must now match the real terrain height by
           hand: there is no physics settling to correct a wrong z.
           Switch/breaker links below are untouched, so the arm can still
           flip them normally. -->
      <gazebo reference="panel_base_link">
        <gravity>false</gravity>
      </gazebo>

      <gazebo reference="panel_base_link">
        <visual>
          <material>
            <ambient>0.5 0.5 0.55 1.0</ambient>
            <diffuse>0.5 0.5 0.55 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>
      </gazebo>

      <!-- No ros2_control block: publishes joint states for the passive
           switch/breaker joints purely from physics simulation. -->
      <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system"
                name="gz::sim::systems::JointStatePublisher">
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>
</robot>
