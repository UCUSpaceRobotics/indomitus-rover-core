    </link>


    <!-- ===================== BREAKER 1 (MCB_1P.stl) ===================== -->
    <!-- Single-pole miniature circuit breaker toggle, ~14x16x16 mm. -->
    <joint name="panel_breaker_1_joint" type="revolute">
      <parent link="panel_base_link"/>
      <child link="panel_breaker_1_link"/>
      <origin xyz="-0.150607 0.000926 0.305081" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="${pi/3}" effort="5.0" velocity="2.0"/>
      <dynamics damping="0.02" friction="0.02"/>
