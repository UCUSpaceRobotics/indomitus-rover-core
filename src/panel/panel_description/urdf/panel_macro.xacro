<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- sim:=true enables the Gazebo-only blocks (joint state publishing for
       the passive switch/breaker joints). The panel has no ros2_control
       hardware of its own: switches are passive bodies the arm interacts
       with via contact physics, not actuated joints. -->
  <xacro:arg name="sim" default="false"/>

  <xacro:macro name="indomitus_panel" params="parent_link *origin">

    <xacro:property name="mesh_path" value="package://panel_description/meshes"/>
    <xacro:property name="stl_scale" value="0.001 0.001 0.001"/>

    <!-- Component placement (x along panel width, z up the panel face) is a
         placeholder spread across the board, inferred only from each STL's
         own bounding box: there is no source CAD assembly telling us the
         real mounting holes. panel.stl's dominant flat face sits at
         y ~= -0.015 m (found by a vertex-density check of the mesh), which
         is assumed to be the front the arm approaches; verify this visually
         in RViz/Gazebo and adjust these origins once the real layout is
         confirmed. -->

    <material name="panel_grey">
      <color rgba="0.5 0.5 0.55 1.0"/>
    </material>

    <material name="power_switch_pink">
      <color rgba="0.83 0.42 0.5 1.0"/>
    </material>

    <material name="breaker_white">
      <color rgba="0.92 0.92 0.92 1.0"/>
    </material>

    <material name="indicator_green">
      <color rgba="0.25 0.85 0.3 1.0"/>
    </material>

    <material name="socket_grey">
      <color rgba="0.65 0.65 0.68 1.0"/>
    </material>

    <material name="marker_black">
      <color rgba="0.03 0.03 0.03 1.0"/>
    </material>

    <xacro:macro name="dummy_inertia" params="mass">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </xacro:macro>

    <!-- ===================== BASE PLATE ===================== -->
    <joint name="panel_mount_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent_link}"/>
      <child link="panel_base_link"/>
    </joint>

    <link name="panel_base_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/panel.stl" scale="${stl_scale}"/></geometry>
        <material name="panel_grey"/>
      </visual>
      <collision>
        <!-- panel.stl is a heavy (231k-triangle) non-convex mesh: DART
             either takes very long to build a convex decomposition for it
             or refuses it outright, which was making the whole model fail
             to spawn. A box is cheap and this link is static anyway. -->
        <origin xyz="0 0.013 0.225" rpy="0 0 0"/>
        <geometry><box size="0.33 0.072 0.45"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="3.0"/>
    </link>

    <!-- ===================== MAIN SWITCH 1 (main_switch.stl) ===================== -->
    <!-- Large toggle/rotary switch, ~65x65x29 mm. -->
    <joint name="panel_main_switch_1_joint" type="revolute">
      <parent link="panel_base_link"/>
      <child link="panel_main_switch_1_link"/>
      <origin xyz="0.042355 -0.0059 0.109905" rpy="${pi/2} ${-pi/2} 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-pi/2}" upper="0" effort="5.0" velocity="2.0"/>
      <dynamics damping="0.05" friction="0.05"/>
    </joint>

    <link name="panel_main_switch_1_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/main_switch.stl" scale="${stl_scale}"/></geometry>
        <material name="power_switch_pink"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/main_switch.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="0.05"/>
    </link>


    <!-- ===================== MAIN SWITCH 2 (main_switch.stl) ===================== -->
    <!-- Large toggle/rotary switch, ~65x65x29 mm. -->
    <joint name="panel_main_switch_2_joint" type="revolute">
      <parent link="panel_base_link"/>
      <child link="panel_main_switch_2_link"/>
      <origin xyz="0.122355 -0.0059 0.109905" rpy="${pi/2} ${-pi/2} 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-pi/2}" upper="0" effort="5.0" velocity="2.0"/>
      <dynamics damping="0.05" friction="0.05"/>
    </joint>

    <link name="panel_main_switch_2_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/main_switch.stl" scale="${stl_scale}"/></geometry>
        <material name="power_switch_pink"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/main_switch.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="0.05"/>
    </link>


    <!-- ===================== SWITCH 1 (switch.stl) ===================== -->
    <!-- Medium toggle switch, ~38x46x29 mm. -->
    <joint name="panel_switch_1_joint" type="revolute">
      <parent link="panel_base_link"/>
      <child link="panel_switch_1_link"/>
      <origin xyz="0.119578 0 0.20797" rpy="0 0 ${pi}"/>
      <axis xyz="0 1 0"/>
      <limit lower="${-pi/2}" upper="0" effort="5.0" velocity="2.0"/>
      <dynamics damping="0.05" friction="0.05"/>
    </joint>

    <link name="panel_switch_1_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/switch.stl" scale="${stl_scale}"/></geometry>
        <material name="panel_grey"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/switch.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="0.03"/>
    </link>


    <!-- ===================== SWITCH 2 (switch.stl) ===================== -->
    <!-- Medium toggle switch, ~38x46x29 mm. -->
    <joint name="panel_switch_2_joint" type="revolute">
      <parent link="panel_base_link"/>
      <child link="panel_switch_2_link"/>
      <origin xyz="0.059789 0 0.20797" rpy="0 0 ${pi}"/>
      <axis xyz="0 1 0"/>
      <limit lower="${-pi/2}" upper="0" effort="5.0" velocity="2.0"/>
      <dynamics damping="0.05" friction="0.05"/>
    </joint>

    <link name="panel_switch_2_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/switch.stl" scale="${stl_scale}"/></geometry>
        <material name="panel_grey"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/switch.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="0.03"/>
    </link>


    <!-- ===================== SWITCH 3 (switch.stl) ===================== -->
    <!-- Medium toggle switch, ~38x46x29 mm. -->
    <joint name="panel_switch_3_joint" type="revolute">
      <parent link="panel_base_link"/>
      <child link="panel_switch_3_link"/>
      <origin xyz="0 0 0.20797" rpy="0 0 ${pi}"/>
      <axis xyz="0 1 0"/>
      <limit lower="${-pi/2}" upper="0" effort="5.0" velocity="2.0"/>
      <dynamics damping="0.05" friction="0.05"/>
    </joint>

    <link name="panel_switch_3_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/switch.stl" scale="${stl_scale}"/></geometry>
