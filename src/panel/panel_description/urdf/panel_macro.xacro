    <link name="panel_breaker_16_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/MCB_1P.stl" scale="${stl_scale}"/></geometry>
        <material name="panel_grey"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/MCB_1P.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="0.01"/>
    </link>


    <!-- ===================== BREAKER 17 (MCB_1P.stl) ===================== -->
    <!-- Single-pole miniature circuit breaker toggle, ~14x16x16 mm. -->
    <joint name="panel_breaker_17_joint" type="revolute">
      <parent link="panel_base_link"/>
      <child link="panel_breaker_17_link"/>
      <origin xyz="0.137393 0.000926 0.305081" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="${pi/6}" upper="${pi/2}" effort="5.0" velocity="2.0"/>
      <dynamics damping="0.02" friction="0.02"/>
    </joint>

    <link name="panel_breaker_17_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/MCB_1P.stl" scale="${stl_scale}"/></geometry>
        <material name="panel_grey"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/MCB_1P.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="0.01"/>
    </link>


    <xacro:if value="$(arg sim)">
      <!-- panel_base_link only: no gravity, so the board itself neither
           falls nor tips over on sloped terrain and just sits exactly at
           its spawn pose (see panel_x/y/z/yaw in sim_gz_full.launch.py).
           This means that pose must now match the real terrain height by
           hand: there is no physics settling to correct a wrong z.
           Switch/breaker links below are untouched, so the arm can still
           flip them normally. -->
      <gazebo reference="panel_base_link">
        <gravity>false</gravity>
      </gazebo>

      <gazebo reference="panel_base_link">
        <visual>
          <material>
            <ambient>0.5 0.5 0.55 1.0</ambient>
            <diffuse>0.5 0.5 0.55 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>
      </gazebo>

      <!-- No ros2_control block: publishes joint states for the passive
           switch/breaker joints purely from physics simulation. -->
      <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system"
                name="gz::sim::systems::JointStatePublisher">
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>
</robot>
