<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>panel_sim</name>
  <version>0.0.0</version>
  <description>
    Gazebo simulation package for the ERC equipment/switch panel,
    including a standalone world, model spawn and ROS-Gazebo bridge
    configuration for the panel's passive switch/button joints.
  </description>
  <maintainer email="indomitus@ucu.edu.ua">UCUSpaceRobotics</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Interfaces -->
  <depend>sensor_msgs</depend>

  <!-- Launch infrastructure -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Internal packages -->
  <exec_depend>panel_description</exec_depend>

  <!-- State publisher -->
  <depend>xacro</depend>
  <depend>robot_state_publisher</depend>

  <!-- Simulation -->
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
