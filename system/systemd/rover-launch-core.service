[Unit]
Description=Rover core (CAN, control, drive, teleop, lamps) in tmux session "core"
After=docker.service
Requires=docker.service

[Service]
# simple, not oneshot: start waits for hardware + the container, and a oneshot
# would hold boot (multi-user.target) until it is done.
Type=simple
RemainAfterExit=yes
TimeoutStopSec=45
# rover.launch.py's default interface:=can_rover - keep in sync.
Environment=CAN_IFACE=can_rover
# LAUNCH_ARGS: the mission's extra launch args, written by rover-mission (/run wins).
EnvironmentFile=-/etc/rover/core.env
EnvironmentFile=-/run/rover/core.env
ExecStart=/usr/local/bin/rover-session start core ros2 launch rover_bringup rover.launch.py $LAUNCH_ARGS
ExecStop=-/usr/local/bin/rover-session stop core

[Install]
WantedBy=multi-user.target
