# Types the launch command into tmux session "arm" inside rover_prod, as if
# someone entered it by hand: attach with `enter_container.sh rover arm`,
# Ctrl-C / up-arrow work as usual. Installed stopped + disabled; enable to
# start this subsystem at boot. Don't start it if the subsystem is already
# running in the session - the command would be typed into the running launch.
[Unit]
Description=Arm (MoveIt, servo, controllers) in tmux session "arm"
After=rover.service
BindsTo=rover.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=120
ExecStartPre=/bin/sh -c 'until docker exec rover_prod true 2>/dev/null; do sleep 2; done'
ExecStart=/usr/bin/docker exec rover_prod sh -c 'tmux has-session -t arm 2>/dev/null || tmux new-session -d -s arm'
ExecStart=/usr/bin/docker exec rover_prod tmux send-keys -t arm 'ros2 launch arm_bringup arm.launch.py use_fake_hardware:=false' Enter
ExecStop=-/usr/bin/docker exec rover_prod tmux send-keys -t arm C-c

[Install]
WantedBy=rover.service
