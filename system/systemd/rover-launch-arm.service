[Unit]
Description=Arm (MoveIt, servo, controllers) in tmux session "arm"
After=docker.service
Requires=docker.service

[Service]
# simple, not oneshot: start waits for hardware + the container, and a oneshot
# would hold boot (multi-user.target) until it is done.
Type=simple
RemainAfterExit=yes
TimeoutStopSec=45
# arm_macro.xacro's default can_interface (arm.launch.py passes none) - keep in sync.
Environment=CAN_IFACE=can0
# LAUNCH_ARGS: the mission's extra launch args, written by rover-mission (/run wins).
EnvironmentFile=-/etc/rover/arm.env
EnvironmentFile=-/run/rover/arm.env
ExecStart=/usr/local/bin/rover-session start arm ros2 launch arm_bringup arm.launch.py use_fake_hardware:=false $LAUNCH_ARGS
ExecStop=-/usr/local/bin/rover-session stop arm

[Install]
WantedBy=multi-user.target
