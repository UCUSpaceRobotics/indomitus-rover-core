# Types the launch command into tmux session "cameras" inside rover_prod, as if
# someone entered it by hand: attach with `enter_container.sh rover cameras`,
# Ctrl-C / up-arrow work as usual. Waits in the background for the container
# without holding up boot; no wait for cameras - camera_node waits for missing
# devices and reopens unplugged ones itself. Installed stopped + disabled;
# enable to start this subsystem at boot. Don't start it if the subsystem is
# already running in the session - the command would be typed into the
# running launch.
[Unit]
Description=Rover cameras (MJPEG to GS + image_raw) in tmux session "cameras"
After=docker.service
Requires=docker.service

[Service]
Type=simple
RemainAfterExit=yes
ExecStart=/bin/sh -c '\
    until docker exec rover_prod true 2>/dev/null; do sleep 2; done; \
    docker exec rover_prod sh -c "tmux has-session -t cameras 2>/dev/null || tmux new-session -d -s cameras"; \
    docker exec rover_prod tmux send-keys -t cameras "ros2 launch rover_cameras cameras.launch.py" Enter'
ExecStop=-/usr/bin/docker exec rover_prod tmux send-keys -t cameras C-c

[Install]
WantedBy=multi-user.target
