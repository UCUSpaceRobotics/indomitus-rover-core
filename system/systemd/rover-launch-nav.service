[Unit]
Description=Rover navigation (LiDAR, SLAM, Nav2) in tmux session "nav"
After=docker.service
Requires=docker.service

[Service]
# simple, not oneshot: start waits for hardware + the container, and a oneshot
# would hold boot (multi-user.target) until it is done.
Type=simple
RemainAfterExit=yes
TimeoutStopSec=45
# No hardware wait: navigation.launch.py itself waits for the LiDAR / ZED topics.
# LAUNCH_ARGS: the mission's extra launch args, written by rover-mission (/run wins).
EnvironmentFile=-/etc/rover/nav.env
EnvironmentFile=-/run/rover/nav.env
ExecStart=/usr/local/bin/rover-session start nav ros2 launch rover_bringup navigation.launch.py $LAUNCH_ARGS
ExecStop=-/usr/local/bin/rover-session stop nav

[Install]
WantedBy=multi-user.target
