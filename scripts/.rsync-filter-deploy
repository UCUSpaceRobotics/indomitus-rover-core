# This file defines which files are ignored when copying ./src/ directory to the Jetson with deploy script

# Unneccessary simulation and visualization packages
- rover_viz/
- rover_sim/

# Python
- __pycache__/
- *.pyc
- *.pyo
- .pytest_cache/
- *.egg-info/

# Build artifacts
- build/
- install/
- log/

# Editor / OS noise
- .DS_Store
- *.swp
- *~
- .idea/
- .vscode/

# Git
- .git/
- .gitignore